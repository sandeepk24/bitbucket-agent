# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=info

# Frontend (leave empty in local Vite to use the /api proxy)
VITE_API_BASE_URL=

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Bitbucket Data Center 10.2.x
# Base URL is the instance root (no /rest suffix). Tokens are never logged or returned.
BITBUCKET_BASE_URL=https://bitbucket.example.com
BITBUCKET_TOKEN=
# Optional. When set, REST calls use Basic auth (username:token) as documented for
# user HTTP access tokens. When empty, REST calls use Bearer auth.
BITBUCKET_USERNAME=
BITBUCKET_API_TIMEOUT=30
BITBUCKET_CONNECT_TIMEOUT=5
BITBUCKET_MAX_RETRIES=3
BITBUCKET_PAGE_LIMIT=100
BITBUCKET_MAX_PAGES=50
BITBUCKET_VERIFY_SSL=true
BITBUCKET_WORKSPACE=

# Bamboo (not used yet)
BAMBOO_BASE_URL=
BAMBOO_TOKEN=
BAMBOO_API_TIMEOUT=30

# Amazon Bedrock / Strands (stubs only)
AWS_REGION=us-east-1
AI_PROVIDER=bedrock
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
STRANDS_ENABLED=false
